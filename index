<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sovereign Archive: Interactive Heritage</title>
    <style>
        body { background-color: #0a0a0a; color: #d4af37; font-family: 'Georgia', serif; text-align: center; padding: 20px; }
        .vault-container { border: 2px solid #d4af37; padding: 30px; background: #111; max-width: 900px; margin: auto; box-shadow: 0 0 40px rgba(212, 175, 55, 0.1); }
        h1 { letter-spacing: 5px; text-transform: uppercase; border-bottom: 1px solid #d4af37; padding-bottom: 15px; }
        input { padding: 15px; width: 80%; background: #1a1a1a; border: 1px solid #444; color: #fff; font-size: 1.2em; margin-bottom: 20px; }
        button { padding: 15px 40px; background: #d4af37; color: #000; border: none; font-weight: bold; cursor: pointer; text-transform: uppercase; width: 85%; }
        .timeline { margin-top: 40px; text-align: left; display: none; }
        .event { position: relative; padding: 20px; border-left: 2px solid #d4af37; margin-left: 20px; background: #1a1a1a; margin-bottom: 10px; }
        .year { font-weight: bold; color: #fff; display: block; margin-bottom: 5px; }
        .desc { font-size: 0.95em; color: #ccc; }
        .ancestor-badge { background: #d4af37; color: #000; padding: 2px 8px; font-size: 0.7em; font-weight: bold; border-radius: 3px; margin-left: 10px; }
    </style>
</head>
<body>
    <div class="vault-container">
        <h1>Sovereign Archive</h1>
        <p><i>Enter your name to cross-reference with Global History and the Chaney-Vance-Perry Lineage.</i></p>
        
        <input type="text" id="userName" placeholder="Enter Full Name...">
        <br>
        <button onclick="buildTimeline()">Generate My Timeline</button>

        <div id="timelineOutput" class="timeline">
            <h2 id="resultHeader" style="color: #fff; margin-left: 20px;"></h2>
            <div id="eventList"></div>
        </div>
    </div>

    <script>
        const familyData = {
            "oshel chaney": { year: "1949", text: "Son of Newman Chaney and Arminda Vance. Bridge to modern lineage.", isFamily: true },
            "leonard chaney": { year: "1897", text: "Born Mar 22. Husband of Lillie Dyer. Veteran Era generation.", isFamily: true },
            "john hobert vance": { year: "1895", text: "Born Jun 12. Husband of Erie Elmer Watts. Appalachian frontier roots.", isFamily: true },
            "thomas john clay": { year: "1884", text: "Born Oct 16. Husband of Clara Davis. Roots of the Clay-Perry line.", isFamily: true }
        };

        const globalHistory = [
            { year: "1789", text: "French Revolution begins / Jenny Wiley frontier survival era." },
            { year: "1861", text: "American Civil War begins; major shifts in Ohio Valley migration." },
            { year: "1914", text: "World War I begins; Leonard Chaney and John Hobert Vance era." },
            { year: "1945", text: "End of WWII; Beginning of the modern industrial boom." }
        ];

        function buildTimeline() {
            const name = document.getElementById('userName').value.trim();
            const nameLow = name.toLowerCase();
            const list = document.getElementById('eventList');
            const output = document.getElementById('timelineOutput');
            
            list.innerHTML = "";
            output.style.display = "block";
            document.getElementById('resultHeader').innerText = "Historical Timeline for " + name;

            // 1. Check for Family Match
            if (familyData[nameLow]) {
                addEvent(familyData[nameLow].year, familyData[nameLow].text, true);
            }

            // 2. Add Global Context
            globalHistory.forEach(event => {
                addEvent(event.year, event.text, false);
            });

            // 3. Add Custom User Entry
            addEvent("TODAY", name + " accesses the Sovereign Archive, linking their identity to the global record.", false);
        }

        function addEvent(year, text, isFamily) {
            const list = document.getElementById('eventList');
            const div = document.createElement('div');
            div.className = "event";
            div.innerHTML = `<span class="year">${year} ${isFamily ? '<span class="ancestor-badge">ANCESTRAL RECORD</span>' : ''}</span><div class="desc">${text}</div>`;
            list.appendChild(div);
        }
    </script>
</body>
</html>
